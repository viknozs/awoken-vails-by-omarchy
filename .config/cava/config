[general]
# Anzahl der VU-Balken in der Waybar (z. B. 8 bis 12 ist ideal)
bars = 12
framerate = 60
autosens = 1

[input]
# PipeWire Direktzugriff für saubere Signale
method = pipewire
source = auto

[output]
# Ausgangsmodus für Text-Leisten (ASCII an stdout)
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
noise_reduction = 77
