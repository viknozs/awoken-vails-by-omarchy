{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "bottom",
  "spacing": 0,
  "height": 30,

  // 1. MODULE-AUFTEILUNG
  "modules-left": [
    "custom/awoken",                   // Ganz links aussen vor der Uhr
    "custom/clock"                     // Die Uhr in Worten direkt danach
  ],
  "modules-center": [
    "custom/vumeter",                  // VU-Meter, strahlt nach links vom Lautstaerke-Icon aus
    "pulseaudio",                      // Lautstaerke, symmetrisch zum WLAN-Symbol rechts vom Menue
    "custom/update",                   // Update-Icon direkt links neben dem Menue
    "custom/omarchy",                  // Das Oggtions-Menue EXAKT in der Mitte
    "tray",                            // Tray ohne Erweiterungspfeil, direkt sichtbar
    "network",                         // ab hier mit mehr Abstand zum Omarchy-Menue
    "bluetooth",
    "cpu",
    "battery"
  ],
  "modules-right": [
    "hyprland/workspaces"              // Die Workspaces wandern ganz nach rechts aussen
  ],

  // 2. TEXT-MODULE & UHR
  "custom/awoken": {
    "format": "awøken⸸vails",
    "tooltip": false
  },
  "custom/clock": {
    "exec": "~/.config/waybar/clock.sh",
    "interval": 60,
    "format": "{}",
    "tooltip": false
  },
  "custom/vumeter": {
    "exec": "~/.config/waybar/vumeter.sh",
    "interval": "once",
    "format": "{}",
    "tooltip": false
  },

  // 3. WORKSPACES (ohne das stoerende "active"-Dreieck)
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    },
    "format-icons": {
      "1": "sub43",
      "2": "doge",
      "3": "butler",
      "4": "vøid",
      "5": "Ogger"
    }
  },

  // 4. OMARCHY & UPDATE
  "custom/omarchy": {
    "format": "▽",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "Oggtions (The Great Turn)\n\nSuper + Alt + Space"
  },
  "custom/update": {
    "format": "",
    "exec": "omarchy-update-available",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-upgrade",
    "tooltip-format": "Omarchy update available",
    "signal": 7,
    "interval": 21600
  },

  // 5. AUDIO & HARDWARE
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "omarchy-launch-audio",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    }
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "on-click": "omarchy-launch-or-focus-tui btop",
    "on-click-right": "alacritty"
  },

  // 6. AKKU - jetzt echtes Batteriesymbol statt nur Prozentzahl
  //    (Prozent steht noch im Tooltip, wenn man mit der Maus draufgeht)
  "battery": {
    "format": "{icon}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging": "󰂄",
    "format-full": "󰁹",
    "interval": 30,
    "tooltip-format": "{capacity}%"
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "omarchy-launch-wifi"
  },
  "bluetooth": {
    "format": "",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "omarchy-launch-bluetooth"
  },

  // TRAY - ohne Erweiterungspfeil, immer sichtbar
  "tray": {
    "icon-size": 12,
    "spacing": 17
  }
}
